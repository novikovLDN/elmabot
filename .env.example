# --- Telegram ---
BOT_TOKEN=123456:your-bot-token
ADMIN_TELEGRAM_ID=123456789

# --- Database (PostgreSQL 14+) ---
DATABASE_URL=postgresql://user:password@localhost:5432/vpnbot

# --- Remnawave VPN panel ---
REMNAWAVE_URL=https://panel.example.com
REMNAWAVE_TOKEN=your-remnawave-api-token

# --- Product / pricing ---
PRICE_STARS=99
SUBSCRIPTION_DAYS=30
TRIAL_DAYS=2

# --- Branding / onboarding (optional) ---
# Per-platform "download app" links on the device connection screens.
# Defaults point at the public Happ client; override if you ship another app.
APP_IOS_URL=https://apps.apple.com/app/happ-proxy-utility/id6504287215
APP_ANDROID_URL=https://play.google.com/store/apps/details?id=com.happproxy
APP_MACOS_URL=https://apps.apple.com/app/happ-proxy-utility/id6504287215
APP_WINDOWS_URL=https://github.com/Happ-proxy/happ-desktop/releases/latest
APP_ANDROIDTV_URL=https://play.google.com/store/apps/details?id=com.happproxy

# --- Optional tuning ---
# Interval (seconds) between scheduler passes
REMINDER_INTERVAL_SECONDS=600
EXPIRY_INTERVAL_SECONDS=600
# Traffic limit per user in GB (0 = unlimited)
VPN_TRAFFIC_LIMIT_GB=0
# Logging level
LOG_LEVEL=INFO
